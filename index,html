<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberSafe</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>CyberSafe 🛡️</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#tips">Safety Tips</a>
            <a href="#quiz">Quiz</a>
        </nav>
    </header>

    <section id="home" class="hero">
        <h2>Stay Safe in the Digital World</h2>
        <p>Learn how to protect yourself online and keep your information secure.</p>
        <a href="#tips" class="btn">Explore Safety Tips</a>
    </section>

    <section id="tips">
        <h2>Cybersecurity Tips</h2>

        <div class="cards">

            <div class="card">
                <h3>🔐 Password Safety</h3>
                <p>Use strong and unique passwords for your accounts.</p>
            </div>

            <div class="card">
                <h3>🎣 Phishing Awareness</h3>
                <p>Avoid suspicious links and unknown email attachments.</p>
            </div>

            <div class="card">
                <h3>🤖 AI Safety</h3>
                <p>Never share sensitive personal information with AI tools.</p>
            </div>

            <div class="card">
                <h3>🛡️ Online Privacy</h3>
                <p>Protect your personal information when browsing online.</p>
            </div>

        </div>
    </section>

    <section id="quiz">
        <h2>Test Your Knowledge!</h2>

        <p>Should you share your password with others?</p>

        <button onclick="checkAnswer('yes')">Yes</button>
        <button onclick="checkAnswer('no')">No</button>

        <p id="result"></p>
    </section>

    <footer>
        <p>© 2026 CyberSafe | Stay Safe, Stay Smart 💜</p>
    </footer>

    <script src="script.js"></script>

</body>
</html>